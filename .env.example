# Скопируйте в .env и заполните. .env не попадает в git (права 600 на сервере).

# Окружение: production | development | test
APP_ENV=development

# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Пароль Postgres (используется в docker-compose.yml)
POSTGRES_PASSWORD=change-me

# Для тестов (база club_test создаётся init-скриптом из deploy/postgres)
TEST_DATABASE_URL=postgresql+psycopg://club:change-me@db:5432/club_test

# 1 — собрать образ с pytest (локально); на сервере оставить 0
INSTALL_DEV=0

# Публичный адрес сайта (ссылки в письмах и возврат со страницы Stripe)
BASE_URL=https://localhost

# Stripe Identity: ключи только из .env. Для разработки — тестовые ключи (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Страны, документы и проживание из которых не принимаем (через запятую, ISO-коды)
# По умолчанию: RU BY CN CU IR KP SY (см. ARCHITECTURE.md §11). Пустое значение отключает список.
# BLOCKED_DOCUMENT_COUNTRIES=RU,BY,CN,CU,IR,KP,SY
# BLOCKED_RESIDENCE_COUNTRIES=RU,BY,CN,CU,IR,KP,SY

# ИИ: модели меняются здесь, код не нужен. Проверка: docker compose exec app flask ai-check
# LLM_PROVIDER: anthropic | openai | google | mistral | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Только для openai_compatible (локальный сервер, например Ollama: http://ollama:11434/v1)
LLM_BASE_URL=
LLM_API_KEY=
# EMBEDDING_PROVIDER: lexical | openai | google | mistral | openai_compatible | none
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Ключи провайдеров (нужны только для выбранных провайдеров)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Почта — настраивается при деплое. Без SMTP_HOST письма только пишутся в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=club@localhost

# Пароль для тестовых участников (команда flask seed-test-users). Только для разработки.
TEST_SEED_PASSWORD=

# Поиск по закону (инструмент «Gesetzes-Suche»). Пусто — инструмент скрыт.
LAWS_API_URL=

# Корпус законов внутри клуба (flask laws-import / laws-sync). Ключ Mistral нужен для смыслового поиска и обновления векторов.
MISTRAL_API_KEY=
LAWS_SOURCE=auto

# Голосовой ввод Clubi: провайдеры распознавания речи по порядку (ключ нужен у каждого, без ключа пропускается)
STT_PROVIDERS=mistral,openai
STT_MISTRAL_MODEL=voxtral-mini-latest
STT_OPENAI_MODEL=gpt-4o-mini-transcribe
