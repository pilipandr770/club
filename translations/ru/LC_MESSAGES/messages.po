#: app/services/tools/security.py:213 app/services/tools/security.py:216
#: app/services/tools/security.py:221
msgid "SPF"
msgstr "SPF"

#: app/services/tools/security.py:213
msgid ""
"Die Domain empfängt keine Mails, ist aber nicht gegen Missbrauch als "
"Absender geschützt."
msgstr "Домен не принимает почту, но не защищён от подделки отправителя."

#: app/services/tools/security.py:214
msgid ""
"SPF „v=spf1 -all“ eintragen: damit ist klar, dass von dieser Domain keine "
"Mails kommen dürfen."
msgstr "Добавить SPF «v=spf1 -all»: это явно запрещает отправку почты от домена."

#: app/services/tools/security.py:216
msgid "Kein SPF-Eintrag: Fremde können leichter in deinem Namen Mails versenden."
msgstr "Запись SPF отсутствует: посторонним проще отправлять почту от вашего имени."

#: app/services/tools/security.py:217
msgid "SPF-Eintrag (TXT, „v=spf1 … -all“) mit den erlaubten Versendern anlegen."
msgstr "Добавить SPF (TXT, «v=spf1 … -all») с разрешёнными отправителями."

