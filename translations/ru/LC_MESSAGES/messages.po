msgstr "Включить DNSSEC у регистратора домена или DNS-провайдера."

#: app/services/tools/security.py:243
msgid "CAA (erlaubte Zertifikatsaussteller)"
msgstr "CAA (разрешённые издатели сертификатов)"

#: app/services/tools/security.py:244 app/services/tools/security.py:256
msgid "Vorhanden."
msgstr "Присутствует."

#: app/services/tools/security.py:245
msgid ""
"CAA-Eintrag anlegen, damit nur gewünschte Stellen Zertifikate ausstellen "
"dürfen."
msgstr ""
"Добавить запись CAA, чтобы выдавать сертификаты могли только разрешённые "
"центры."

