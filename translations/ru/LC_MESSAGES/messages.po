#: app/services/tools/security_extra.py:88
#, python-format
msgid "Freigabe nur für %(value0)s."
msgstr "Доступ разрешён только для %(value0)s."

#: app/services/tools/security_extra.py:89
msgid ""
"Access-Control-Allow-Origin nicht auf * setzen, wenn Zugangsdaten oder "
