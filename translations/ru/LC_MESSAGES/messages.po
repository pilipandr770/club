msgstr "Сторонние скрипты без проверки целостности (SRI)"

#: app/services/tools/security_extra.py:216
#, python-format
msgid "%(value0)s fremde(s) Skript(e) ohne integrity-Attribut, z. B. %(value1)s."
msgstr "Сторонних скриптов без атрибута integrity: %(value0)s, например %(value1)s."

#: app/services/tools/security_extra.py:217
msgid ""
"Bei fremden Skripten ein integrity-Attribut setzen oder die Dateien selbst "
