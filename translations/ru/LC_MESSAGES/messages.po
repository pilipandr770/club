#: app/services/tools/security_extra.py:78
msgid "Qualität der Content-Security-Policy"
msgstr "Качество Content-Security-Policy"

#: app/services/tools/security_extra.py:79
#: app/services/tools/security_extra.py:106
#: app/services/tools/security_extra.py:225
#: app/services/tools/security_extra.py:503
#: app/services/tools/security_extra.py:580
msgid "."
msgstr "."

#: app/services/tools/security_extra.py:79
msgid "Keine typischen Schwächen erkannt."
msgstr "Типичные слабые места не обнаружены."

#: app/services/tools/security_extra.py:80
msgid ""
"Die Policy verschärfen: kein 'unsafe-inline'/'unsafe-eval', Skriptquellen "
