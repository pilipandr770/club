#: app/templates/modules/profile_view.html:46
msgid "Contact:"
msgstr "Контакт:"

#: app/templates/modules/profile_matches.html:44
#: app/templates/modules/profile_view.html:50
msgid "Your request is waiting for an answer."
msgstr "Ваш запрос ожидает ответа."

#: app/templates/modules/profile_matches.html:46
#: app/templates/modules/profile_view.html:52
msgid "This member has asked to contact you. Answer in your requests."
msgstr "Этот участник запросил знакомство с вами. Ответьте в разделе запросов."

#: app/templates/modules/profile_matches.html:51
#: app/templates/modules/profile_view.html:67
