msgstr "Нет незащищённых ресурсов на HTTPS-странице"

#: app/services/tools/security_extra.py:204
#, python-format
msgid "%(value0)s Inhalt(e) über http geladen, z. B. %(value1)s."
msgstr "По http загружается ресурсов: %(value0)s, например %(value1)s."

#: app/services/tools/security_extra.py:205
msgid "Keine http-Inhalte auf der Startseite gefunden."
msgstr "На главной странице не найдены ресурсы по http."

#: app/services/tools/security_extra.py:206
msgid "Alle Skripte, Bilder und Formulare über https laden (Mixed Content beheben)."
msgstr ""
"Загружать все скрипты, изображения и формы по https (устранить смешанное "
"содержимое)."

#: app/services/tools/security_extra.py:208
msgid "Drittanbieter-Quellen auf der Startseite"
msgstr "Сторонние источники на главной странице"

#: app/services/tools/security_extra.py:209
#, python-format
msgid "%(value0)s fremde Quelle(n): %(value1)s."
msgstr "Сторонних источников: %(value0)s; %(value1)s."

