msgstr "Включить DKIM у почтового провайдера и опубликовать ключ в DNS."

#: app/services/tools/security.py:240
msgid "DNSSEC"
msgstr "DNSSEC"

#: app/services/tools/security.py:240
msgid "Signiert (DS-Eintrag vorhanden)."
msgstr "Подписано (есть запись DS)."

#: app/services/tools/security.py:241
msgid "Nicht aktiviert."
msgstr "Не включено."

#: app/services/tools/security.py:241
