msgid "You have been logged out."
msgstr "Du bist abgemeldet."

#: app/blueprints/auth/__init__.py:119 app/blueprints/auth/__init__.py:124
msgid "The link is invalid or has expired. Please request a new one."
msgstr "Der Link ist ungültig oder abgelaufen. Bitte fordere einen neuen an."

#: app/blueprints/auth/__init__.py:131
msgid "Your e-mail address is confirmed."
msgstr "Deine E-Mail-Adresse ist bestätigt."

#: app/blueprints/member/__init__.py:44 app/blueprints/member/__init__.py:50
msgid "Verification cannot be started right now."
msgstr "Die Prüfung kann gerade nicht gestartet werden."

#: app/blueprints/member/__init__.py:61
msgid ""
"We are checking your details. This can take a few minutes. The result "
"appears here and we will not send it by e-mail."
msgstr ""
"Wir prüfen deine Angaben. Das kann einige Minuten dauern. Das Ergebnis "
"erscheint hier; wir schicken es nicht per E-Mail."

#: app/blueprints/member/__init__.py:74
msgid "If your address is not yet confirmed, we have sent a new link."
msgstr ""
"Falls deine Adresse noch nicht bestätigt ist, haben wir dir einen neuen "
"Link geschickt."

#: app/blueprints/member/__init__.py:96
msgid "The password is not correct. Your account was not deleted."
msgstr "Das Passwort ist nicht korrekt. Dein Konto wurde nicht gelöscht."

#: app/blueprints/member/__init__.py:104
msgid "Your account could not be deleted right now. Please try again later."
msgstr ""
"Dein Konto konnte gerade nicht gelöscht werden. Bitte versuche es später "
"noch einmal."

#: app/blueprints/member/__init__.py:108
msgid "Your account and your data have been deleted."
msgstr "Dein Konto und deine Daten wurden gelöscht."

